<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name="io.appwin.notifications.PushTapActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity
            android:name="io.appwin.notifications.InAppMessageActivity"
            android:exported="false"
            android:theme="@style/Theme.Appwin.Sdk"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- Merged when the host app depends on firebase-messaging. -->
        <service
            android:name="io.appwin.notifications.AppwinFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
